{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook guard-paths",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "wk hook guard-block",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "wk hook policy-stale",
            "timeout": 10,
            "statusMessage": "проверка политик"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "wk hook check",
            "timeout": 10,
            "statusMessage": "проверка документации и политик"
          }
        ]
      }
    ]
  }
}
